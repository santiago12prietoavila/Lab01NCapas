<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Private Investigation Technology</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.3/css/jquery.dataTables.min.css" />

    <!-- Include Custom CSS Files -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplicationOrders.styles.css" asp-append-version="true" />

    <!-- Include Font Awesome for icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

    <!-- Include Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    

    <!-- Optional: Inline styles for testing -->
    <style>
        body {
            background-color: #f0f4f8; /* Color de fondo */
        }

        .navbar {
            background-color: #004085; /* Fondo del navbar */
        }

        .navbar-brand, .navbar-nav .nav-link {
            color: #ffffff !important; /* Color del texto del navbar */
        }

        .button-container {
            background-color: #e9ecef; /* Fondo detrás de los botones */
            padding: 10px;
            border-radius: 5px;
        }

        .custom-button {
            color: #ffffff !important; /* Color del texto del botón */
            background-color: #007bff; /* Color de fondo del botón */
            border-color: #007bff; /* Color del borde del botón */
            padding: 8px 15px;
            margin-right: 10px;
            border-radius: 5px;
            text-decoration: none;
        }

            .custom-button.product {
                background-color: #28a745; /* Verde para el botón de Producto */
                border-color: #28a745;
            }

            .custom-button.customer {
                background-color: #17a2b8; /* Azul claro para el botón de Cliente */
                border-color: #17a2b8;
            }

            .custom-button.supplier {
                background-color: #ffc107; /* Amarillo para el botón de Proveedor */
                border-color: #ffc107;
            }

            .custom-button:hover {
                opacity: 0.9;
            }

        .footer {
            background-color: #343a40; /* Color de fondo del pie de página */
        }

            .footer a {
                color: #ffffff !important; /* Color del texto del pie de página */
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">WebApplicationOrders</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mr-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <div class="button-container">
                        <a href="@Url.Action("Index", "Product")" class="custom-button product">Product</a>
                        <a href="@Url.Action("Index", "Customer")" class="custom-button customer">Customer</a>
                        <a href="@Url.Action("Index", "Supplier")" class="custom-button supplier">Supplier</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Private Investigation Technology - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Include JavaScript Files -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.3/js/jquery.dataTables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Render additional scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
